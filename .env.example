# MCP Gateway Environment Variables
# Copy this file to .env and fill in your actual values

# ==============================================================================
# REQUIRED CONFIGURATION
# ==============================================================================

# Organization mapping configuration
# Path to a JSON file mapping organization IDs to Ragie partitions and collections
# Path can be absolute or relative to the current working directory
# The file is loaded once at startup - changes require a restart
#
# Mapping file structure:
# {
#   "org_11111111111111111111111111": {
#     "collection-name": {
#       "partition": "soc2",
#       "apiKey": "ragie_api_key_for_this_org_collection",
#       "allowedRoles": ["admin", "member"]  // or "*" for all roles
#     },
#     "another-collection": {
#       "partition": "custom-partition",
#       "apiKey": "different_api_key",
#       "allowedRoles": "*"
#     }
#   },
#   "org_22222222222222222222222222": {
#     "default": {
#       "partition": "production",
#       "apiKey": "production_api_key",
#       "allowedRoles": ["admin"]
#     }
#   }
# }
#
# Each organization can have multiple collections, and each collection mapping must include:
#   - partition (required): The Ragie partition name to route to
#   - apiKey (required): The Ragie API key for this organization/collection combination
#   - allowedRoles (required): Array of role names or "*" to allow all roles
#     The gateway enforces role-based access control using WorkOS organization membership roles.
#
# The gateway endpoint is: POST /:organizationId/mcp/:collection
# Example: POST /org_11111111111111111111111111/mcp/collection-name
MAPPING_FILE=mapping.json

# WorkOS Configuration
# Get these from your WorkOS dashboard at https://dashboard.workos.com
WORKOS_API_KEY=your_workos_api_key_here

# The WorkOS AuthKit authorization server URL
# Format: https://api.workos.com/auth/v1 (or your custom domain)
WORKOS_AUTHORIZATION_SERVER_URL=https://api.workos.com/auth/v1

# Your WorkOS application client ID
WORKOS_CLIENT_ID=your_workos_client_id_here

# ==============================================================================
# OPTIONAL CONFIGURATION
# ==============================================================================

# Server Configuration
# Environment mode (development, production, etc.)
# In development mode, SIGINT will shutdown immediately
# In production mode, SIGINT will trigger graceful shutdown
# NODE_ENV=development

# The base URL for the Gateway server's public endpoint
# If not provided, defaults to http://localhost:{PORT} based on the bound hostname and port
# This is used for OAuth discovery endpoints and error messages
# BASE_URL=http://localhost:3000

# Server port (defaults to 3000)
# PORT=3000

# Logging Configuration
# Logging level - debug, info, warn, or error (defaults to info)
# LOG_LEVEL=info

# Log format - json or pretty (defaults to pretty)
# Use "json" for production environments with log aggregation systems
# Use "pretty" for development and local debugging
# LOG_FORMAT=pretty

# Ragie API Configuration
# Ragie API base URL (defaults to https://api.ragie.ai/)
# This is the base URL for the Ragie MCP server that requests will be proxied to
# RAGIE_BASE_URL=https://api.ragie.ai/
