# MCP Gateway Environment Variables
# Copy this file to .env and fill in your actual values

# ==============================================================================
# REQUIRED CONFIGURATION
# ==============================================================================

# Database connection URL
# Collections are stored in the database with encrypted API keys
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mcp-gateway

# Encryption key for decrypting API keys stored in the database
# Must be at least 32 characters long
# Use the same key that was used to encrypt the API keys in the manager application
ENCRYPTION_KEY=your-encryption-key-at-least-32-characters

# WorkOS Configuration
# Get these from your WorkOS dashboard at https://dashboard.workos.com
WORKOS_API_KEY=your_workos_api_key_here

# The WorkOS AuthKit authorization server URL
# Format: https://api.workos.com/auth/v1 (or your custom domain)
WORKOS_AUTHORIZATION_SERVER_URL=https://api.workos.com/auth/v1

# Your WorkOS application client ID
WORKOS_CLIENT_ID=your_workos_client_id_here

# ==============================================================================
# OPTIONAL CONFIGURATION
# ==============================================================================

# Server Configuration
# Environment mode (development, production, etc.)
# In development mode, SIGINT will shutdown immediately
# In production mode, SIGINT will trigger graceful shutdown
# NODE_ENV=development

# The base URL for the Gateway server's public endpoint
# If not provided, defaults to http://localhost:{PORT} based on the bound hostname and port
# This is used for OAuth discovery endpoints and error messages
# BASE_URL=http://localhost:3000

# Server port (defaults to 3000)
# PORT=3000

# Logging Configuration
# Logging level - debug, info, warn, or error (defaults to info)
# LOG_LEVEL=info

# Log format - json or pretty (defaults to pretty)
# Use "json" for production environments with log aggregation systems
# Use "pretty" for development and local debugging
# LOG_FORMAT=pretty

# Ragie API Configuration
# Ragie API base URL (defaults to https://api.ragie.ai/)
# This is the base URL for the Ragie MCP server that requests will be proxied to
# RAGIE_BASE_URL=https://api.ragie.ai/
